# Application Settings
PROJECT_NAME="Personal Finance Management API"
ENVIRONMENT=development

# Database (SQLite for easy local non-Docker development; overridden to PostgreSQL in docker-compose.yml)
DATABASE_URL=sqlite+aiosqlite:///./finance.db
DB_ECHO=False

# PostgreSQL (Used automatically by docker-compose.yml or uncomment for local Postgres)
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=finance_tracker

# Security (JWT) - Change for production
SECRET_KEY=change-this-to-a-secure-random-secret-key-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# CORS Settings (JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local LLM Integration (Phase 5 - overridden to http://ollama:11434 in docker-compose.yml)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_TIMEOUT_SECONDS=45.0
